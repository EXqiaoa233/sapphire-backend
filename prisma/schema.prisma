// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  sid      String  @id @unique
  lid      String  @unique
  username String?
  avatar   String?

  matchRecords MatchRecord[]

  score      Int
  record     Int
  winRecords Int @map("win_record")

  superuser   Superuser? @relation(fields: [superuserid], references: [account])
  superuserid String?

  createAt  DateTime  @default(now()) @map("created_at")
  updateAt  DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

model MatchRecord {
  id      Int    @id @default(autoincrement())
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String @map("match_id")
  sid     String
  user    User   @relation(fields: [sid], references: [sid])

  lid String

  hero          String
  lvl           Int
  score         Int
  teamnumber    Int
  kill          Int
  assist        Int
  death         Int
  tower         Int
  items         String[]
  normalSkill   String   @map("normal_skill")
  ultimateSkill String   @map("ultimate_skill")
  doneDamage    Int      @map("done_damage")
  takeDamage    Int      @map("take_damage")
  target        String

  createAt  DateTime? @default(now()) @map("created_at")
  updateAt  DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("match_record")
}

model Match {
  id     String  @id @unique @map("match_id")
  time   Int?
  urd    Boolean
  winner Int?

  players MatchRecord[]
  stats   MatchStats?

  createAt  DateTime  @default(now()) @map("created_at")
  updateAt  DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("matchs")
}

// 局内埋点原始数据（游戏 util/match_stats.lua 上报的 stats 字段），验证后再用于评分
model MatchStats {
  id      Int    @id @default(autoincrement())
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String @unique @map("match_id")
  version Int
  data    Json

  createAt DateTime @default(now()) @map("created_at")
  updateAt DateTime @updatedAt @map("updated_at")

  @@map("match_stats")
}

model Superuser {
  id Int @id @default(autoincrement())

  account  String  @unique
  salt     String?
  password String
  username String
  avatar   String?

  user User[]

  createAt  DateTime  @default(now()) @map("created_at")
  updateAt  DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("superusers")
}

// 试运行天梯：只用带 match_stats 的比赛计算，与 users.score 互不影响
model LadderRating {
  sid        String    @id
  rating     Float     @default(1000)
  rd         Float     @default(350)
  vol        Float     @default(0.06)
  core       Float     @default(0.5)
  ratingCore Float     @default(1000) @map("rating_core")
  ratingSup  Float     @default(1000) @map("rating_sup")
  games      Int       @default(0)
  wins       Int       @default(0)
  lastMatch  String?   @map("last_match")
  lastPlayedAt DateTime? @map("last_played_at")

  createAt DateTime @default(now()) @map("created_at")
  updateAt DateTime @updatedAt @map("updated_at")

  @@map("ladder_ratings")
}

// 每局每人一行；counted=false 的行只用来标记已处理（reason 写原因）
model LadderHistory {
  id      Int     @id @default(autoincrement())
  matchId String  @map("match_id")
  sid     String
  team    Int
  win     Boolean
  counted Boolean
  reason  String?

  roleT       Float @map("role_t")
  coreWeight  Float @map("core_weight")
  killValue   Float @map("kill_value")
  assistValue Float @map("assist_value")
  perf        Float
  baseDelta   Float @map("base_delta")
  delta       Float
  ratingBefore Float @map("rating_before")
  ratingAfter  Float @map("rating_after")
  rdBefore     Float @map("rd_before")
  rdAfter      Float @map("rd_after")
  coreAfter    Float @map("core_after")

  createAt DateTime @default(now()) @map("created_at")

  @@unique([matchId, sid])
  @@index([sid])
  @@map("ladder_history")
}
